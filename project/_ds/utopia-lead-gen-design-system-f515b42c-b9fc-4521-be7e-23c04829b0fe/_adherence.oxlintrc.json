        "selector": "JSXOpeningElement[name.name='WhatsAppButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|size|fullWidth|hoverStyle|onClick|key|ref|className|style|children)$/]",
        "message": "<WhatsAppButton> doesn't accept that prop. Declared props: label, href, size, fullWidth, hoverStyle, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|card|sm)$/]",
        "message": "<WhatsAppButton> size must be one of 'hero' | 'card' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppButton'] > JSXAttribute[name.name='hoverStyle'] > Literal[value!=/^(?:invert|yellow|darken)$/]",
        "message": "<WhatsAppButton> hoverStyle must be one of 'invert' | 'yellow' | 'darken'."
