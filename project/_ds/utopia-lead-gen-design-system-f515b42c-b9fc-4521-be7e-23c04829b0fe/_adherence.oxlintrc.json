      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|h2|h3)$/]",
        "message": "<SectionHeading> size must be one of 'display' | 'h2' | 'h3'."
