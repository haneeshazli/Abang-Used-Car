      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionHeading> as must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|nameAccent|phone|email|company|address|socials|bg|copyright|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: name, nameAccent, phone, email, company, address, socials, bg, copyright."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|nameAccent|tagline|logoSrc|variant|stripe|sticky|onMenu|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: name, nameAccent, tagline, logoSrc, variant, stripe, sticky, onMenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|brand)$/]",
        "message": "<SiteHeader> variant must be one of 'light' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<StatBlock> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|body|variant|children|key|ref|className|style|children)$/]",
        "message": "<StepCard> doesn't accept that prop. Declared props: n, title, body, variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:badge|ring|outline)$/]",
        "message": "<StepCard> variant must be one of 'badge' | 'ring' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:rating|text|bg|showGoogle|key|ref|className|style|children)$/]",
        "message": "<TrustStrip> doesn't accept that prop. Declared props: rating, text, bg, showGoogle."
      },
