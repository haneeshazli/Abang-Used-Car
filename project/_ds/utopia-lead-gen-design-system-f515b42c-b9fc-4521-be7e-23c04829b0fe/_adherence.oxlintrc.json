{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/cta/**",
              "components/layout/**",
              "components/lists/**",
              "components/sections/**",
              "ui_kits/lead-gen/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Wix Madefor Display|Wix Madefor Text))/i]",
        "message": "Font not provided by the design system. Available: Wix Madefor Display, Wix Madefor Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|highlight|ourLabel|key|ref|className|style|children)$/]",
        "message": "<ComparisonTable> doesn't accept that prop. Declared props: columns, rows, highlight, ourLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|defaultOpen|tone|key|ref|className|style|children)$/]",
        "message": "<FAQItem> doesn't accept that prop. Declared props: question, answer, defaultOpen, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<FAQItem> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconSrc|title|body|variant|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: icon, iconSrc, title, body, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:stacked|row|card|list)$/]",
        "message": "<FeatureCard> variant must be one of 'stacked' | 'row' | 'card' | 'list'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingWhatsApp'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|position|bottom|right|key|ref|className|style|children)$/]",
        "message": "<FloatingWhatsApp> doesn't accept that prop. Declared props: href, position, bottom, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingWhatsApp'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute)$/]",
        "message": "<FloatingWhatsApp> position must be one of 'fixed' | 'absolute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|sub|cta|image|imageAlt|badge|bg|bullets|children|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: eyebrow, title, sub, cta, image, imageAlt, badge, bg, bullets, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|children|key|ref|className|style|children)$/]",
        "message": "<Highlight> doesn't accept that prop. Declared props: variant, color, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|marker|underline|whatsapp)$/]",
        "message": "<Highlight> variant must be one of 'accent' | 'marker' | 'underline' | 'whatsapp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeadPickerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:prompt|label|options|tab|ctaLabel|onSubmit|key|ref|className|style|children)$/]",
        "message": "<LeadPickerCard> doesn't accept that prop. Declared props: prompt, label, options, tab, ctaLabel, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationList'] > JSXAttribute > JSXIdentifier[name!=/^(?:groups|columns|key|ref|className|style|children)$/]",
        "message": "<LocationList> doesn't accept that prop. Declared props: groups, columns."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutlineButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|color|size|fullWidth|square|key|ref|className|style|children)$/]",
        "message": "<OutlineButton> doesn't accept that prop. Declared props: label, href, color, size, fullWidth, square."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutlineButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:card|hero)$/]",
        "message": "<OutlineButton> size must be one of 'card' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PackageCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|items|extras|price|ribbon|key|ref|className|style|children)$/]",
        "message": "<PackageCard> doesn't accept that prop. Declared props: image, name, items, extras, price, ribbon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:images|columns|gap|radius|aspect|framed|key|ref|className|style|children)$/]",
        "message": "<PhotoGrid> doesn't accept that prop. Declared props: images, columns, gap, radius, aspect, framed."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|key|ref|className|style|children)$/]",
        "message": "<PillTabs> doesn't accept that prop. Declared props: tabs, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:top|price|bottom|size|bg|accent|key|ref|className|style|children)$/]",
        "message": "<PriceBadge> doesn't accept that prop. Declared props: top, price, bottom, size, bg, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|label|variant|color|href|fullWidth|key|ref|className|style|children)$/]",
        "message": "<PricePill> doesn't accept that prop. Declared props: price, label, variant, color, href, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricePill'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pill|stacked)$/]",
        "message": "<PricePill> variant must be one of 'pill' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|brand|title|tag|pricePrefix|price|unit|ctaLabel|secondaryLabel|badge|href|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, brand, title, tag, pricePrefix, price, unit, ctaLabel, secondaryLabel, badge, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|linkText|href|bg|color|align|key|ref|className|style|children)$/]",
        "message": "<PromoBar> doesn't accept that prop. Declared props: text, linkText, href, bg, color, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBar'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<PromoBar> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|name|location|avatar|stars|key|ref|className|style|children)$/]",
        "message": "<ReviewCard> doesn't accept that prop. Declared props: text, name, location, avatar, stars."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:bg|padY|padX|center|gap|children|style|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: bg, padY, padX, center, gap, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='bg'] > Literal[value!=/^(?:white|tint|tint2|dark|primary|accent|black)$/]",
        "message": "<Section> bg must be one of 'white' | 'tint' | 'tint2' | 'dark' | 'primary' | 'accent' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|sub|tone|align|size|as|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, sub, tone, align, size, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SectionHeading> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'left'."
